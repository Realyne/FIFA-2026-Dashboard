# Redis connection (required in production)
REDIS_URL=redis://localhost:6379/0

# Live data provider: espn (default, free/unofficial) | footballdata (paid failover)
DATA_PROVIDER=espn

# Only needed for DATA_PROVIDER=footballdata or scripts/resolve_team_ids.py
FOOTBALL_DATA_TOKEN=

# Comma-separated SPA origins for CORS, or * (public read-only API)
ALLOWED_ORIGINS=*

# Set to 0 to run the API without the background poller (tests/static-only)
POLL_ENABLED=1
